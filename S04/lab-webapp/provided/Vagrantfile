# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Vagrantfile — Fase 0 (S04 · Run)
#
# Crea SOLO VM base: Ubuntu 24.04 (box bento/ubuntu-24.04), nessuna applicazione.
#
# NB sul box: Canonical NON pubblica piu' box Vagrant dopo 22.04 (jammy), quindi
# 'ubuntu/noble64' non e' scaricabile. Si usa 'bento/ubuntu-24.04', che ha il
# provider virtualbox.

BOX = "bento/ubuntu-24.04"

Vagrant.configure("2") do |config|
  # Box comune a entrambe le VM: Ubuntu 24.04 LTS
  # Configurare PURE base. Le macchine sono volutamente minime (1 CPU / 1GB).
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "web01" do |web|
    web.vm.box = BOX
    web.vm.hostname = "web01"
    web.vm.network "private_network", ip: "192.168.56.11"

    web.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
      vb.name = "s04-web01"
    end
  end

  config.vm.define "db01" do |db|
    db.vm.box = BOX
    db.vm.hostname = "db01"
    db.vm.network "private_network", ip: "192.168.56.12"

    db.vm.provider "virtualbox" do |vb|
      vb.memory = 1024
      vb.cpus = 1
      vb.name = "s04-db01"
    end
  end
end
